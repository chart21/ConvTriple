diff --git a/src/app/encoder_adapter.h b/src/app/encoder_adapter.h
index 2afbbab..09f0460 100644
--- a/src/app/encoder_adapter.h
+++ b/src/app/encoder_adapter.h
@@ -60,6 +60,23 @@ namespace troy::linear {
         inline Plaintext encode_for_plain(const std::vector<T>& elements, MemoryPoolHandle pool) const {
             return encoder.centralize_new(elements, parms_id, pool);
         }
+        inline bool on_device() const { return encoder.on_device(); }
+        // count plaintexts for multiplication from one contiguous host buffer (count x len values): one
+        // upload and one batched kernel instead of an upload and a kernel per plaintext. Device only.
+        inline std::vector<Plaintext> encode_for_plain_batched(const std::vector<T>& elements, size_t count, MemoryPoolHandle pool) const {
+            size_t len = elements.size() / count;
+            utils::Array<T> staging = utils::Array<T>::create_uninitialized(elements.size(), true, pool);
+            staging.copy_from_slice(utils::ConstSlice<T>(elements.data(), elements.size(), false, nullptr));
+            std::vector<Plaintext> out(count);
+            std::vector<Plaintext*> out_ptrs;
+            utils::ConstSliceVec<T> source;
+            for (size_t i = 0; i < count; i++) {
+                out_ptrs.push_back(&out[i]);
+                source.push_back(staging.const_slice(i * len, (i + 1) * len));
+            }
+            encoder.centralize_slice_batched(source, parms_id, out_ptrs, pool);
+            return out;
+        }
         inline std::vector<T> decrypt_outputs(const Decryptor& decryptor, const Ciphertext& ciphertext, MemoryPoolHandle pool) const {
             return encoder.scale_down_new(decryptor.bfv_decrypt_without_scaling_down_new(ciphertext, pool), pool);
         }
